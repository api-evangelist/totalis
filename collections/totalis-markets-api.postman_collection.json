        {
          "id": "7ad26ce7-fb31-4d5e-b336-9b4d0c1089d7",
          "name": "List markets (flat)",
          "request": {
            "name": "List markets (flat)",
            "description": {
              "content": "Returns a paginated list of individual markets, most-traded first. Unlike the event-grouped `GET /markets`, results aren't grouped by event and are never capped per event, so every market is reachable. Filter by venue, category, subcategory, or one or more series.\n\nPaginate with `cursor` until it returns `null`; `meta.total` is the total number of matches. For a complete sync, de-duplicate by `ticker` — markets with equal volume aren't guaranteed a stable order between requests. Scoping to a `subcategory` or `series_ticker` set avoids this entirely.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "markets",
                "list"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "Filter by category, e.g. `sports` or `crypto`."
                },
                {
                  "disabled": false,
                  "key": "venue",
                  "value": "<string>",
                  "description": "Filter by venue: `kalshi` or `polymarket`."
                },
                {
                  "disabled": false,
                  "key": "subcategory",
                  "value": "<string>",
                  "description": "Filter by subcategory, e.g. `world_cup`. Requires `category`."
                },
                {
                  "disabled": false,
                  "key": "frequency",
                  "value": "<string>",
                  "description": "Filter by series cadence: `daily`, `weekly`, `monthly`, or `hourly`."
                },
                {
                  "disabled": false,
                  "key": "series_ticker",
                  "value": "<string>",
                  "description": "Filter by one or more series, comma-separated and case-sensitive, e.g. `KXWCAST,KXWCTCORNERS`. Up to 100."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "active,open",
                  "description": "Filter by status. Defaults to tradeable markets (`active,open`); pass a comma-separated list of `active`, `open`, `closed`, `settled`, `finalized`, or `all`. An empty or unrecognised value returns 400."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque pagination cursor from a previous response's `meta.cursor`. Do not construct manually."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Number of markets per page, from 1 to 500. Defaults to 100. Only the first 10,000 matches are reachable — narrow the filters to page further."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
