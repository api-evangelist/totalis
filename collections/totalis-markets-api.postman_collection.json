      "id": "cbcc40e4-5410-4898-b161-8dc0fd4b7ba7",
      "name": "Markets",
      "description": {
        "content": "Cached Kalshi and Polymarket market data.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3d5362dc-24d5-43f6-85da-fb6d9a5358ce",
          "name": "List Markets",
          "request": {
            "name": "List Markets",
            "description": {
              "content": "List active markets grouped by event across supported venues (Kalshi and Polymarket). Filters: `category`, `venue`, `subcategory` (validated against the selected category), `frequency` (`daily`/`weekly`/`monthly`/`hourly`), `date_filter` (time bucket), and `search`. Pagination is cursor-based at the event level. The response includes `available_subcategories` and `available_frequencies` so clients can drive filter chips from the same result set.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "markets"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "Filter by category. Pass `all` to disable the default category filter."
                },
                {
                  "disabled": false,
                  "key": "venue",
                  "value": "<string>",
                  "description": "Filter by venue. Omit to include all venues."
                },
                {
                  "disabled": false,
                  "key": "subcategory",
                  "value": "<string>",
                  "description": "Filter events by subcategory. Valid values depend on the selected `category` (requires `category` to also be set)."
                },
                {
                  "disabled": false,
                  "key": "frequency",
                  "value": "<string>",
                  "description": "Filter events by the cadence of the underlying series. `other` is intentionally rejected — it's a residual response bucket, not a filter target."
                },
                {
                  "disabled": false,
                  "key": "date_filter",
                  "value": "<string>",
                  "description": "Time bucket filter. If omitted, a default 7-day horizon is applied. Pass `all` to retrieve all active markets regardless of close date."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Full-text search across event/market titles."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque pagination cursor from a previous response's `meta.cursor`. Do not construct manually."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "21",
                  "description": "Events per page. Default 21, max 100. The product `limit × markets_per_event` must not exceed 2000."
                },
                {
                  "disabled": false,
                  "key": "markets_per_event",
                  "value": "10",
                  "description": "Max markets returned per event group. Default 10, max 50."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
